# Configuração LOCAL gerada por npm run setup; não usar em produção.
# DATABASE_URL usa um papel sem privilégios administrativos nem bypass de RLS.
DATABASE_URL=
MIGRATION_DATABASE_URL=
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=
# Exclusivamente provisionamento; nunca enviada ao frontend ou à API em execução.
SUPABASE_SECRET_KEY=
LOCAL_APP_PASSWORD=
DOCKER_DATABASE_URL=
DOCKER_SUPABASE_URL=http://host.docker.internal:54321
